+        return catalog
+    }()
+
+    // MARK: - Families
+
+    static let swift = SyntaxLanguage(
+        lineComments: ["//"],
+        blockComment: ("/*", "*/"),
+        quotes: [.doubleQuote],
+        tripleQuotes: true,
