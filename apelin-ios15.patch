+        #expect(drawnRows(of: sheet, columns: 3) == source)
+        #expect(sortChanges == 3)
+        let unchanged = sheet.contents.elementsEqual(inline.contents) { $0.elementsEqual($1, by: ===) }
+        #expect(unchanged, "sorting changed the rows held")
+    }
