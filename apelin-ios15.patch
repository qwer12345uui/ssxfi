+private extension RawTableRow {
+    /// Whether any cell draws math, whose image the rows only name.
+    var carriesMath: Bool {
+        cells.contains { cell in
+            !cell.content.collect { node -> [Void] in
+                if case .math = node {
+                    return [()]
+                }
+                return []
+            }.isEmpty
+        }
+    }
+}
