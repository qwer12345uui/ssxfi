+        #expect(Set(ascending.dropFirst().map { $0.joined(separator: "|") }) == Set(source.dropFirst().map { $0.joined(separator: "|") }))
+        #expect(ascending.dropFirst().map { Int($0[1])! } == scores.sorted())
+        for row in ascending.dropFirst() {
