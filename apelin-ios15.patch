diff --git a/Packages/MarkdownView/Sources/MarkdownParser/MarkdownInlineNode/MarkdownInlineNode+Rewrite.swift b/Packages/MarkdownView/Sources/MarkdownParser/MarkdownInlineNode/MarkdownInlineNode+Rewrite.swift
