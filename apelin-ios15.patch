+        #expect(descending.dropFirst().map { Int($0[1])! } == scores.sorted(by: >))
+        #expect(descending.dropFirst().filter { $0[1] == "4" }.map(\.[0]) == ["name1", "name3", "name7"])
+
+        sheet.sortControls[1].performTap()
